<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/student_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/student_detail_toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/off_white"
        android:title="@string/student_detail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/student_detail_toolbar">

        <ScrollView
            android:id="@+id/student_detail_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 1. STUDENT IDENTITY PROFILE -->
                <TextView
                    android:id="@+id/student_detail_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="@color/indigo_primary_dark"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/student_detail_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/slate_gray" />

                <TextView
                    android:id="@+id/student_detail_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/status_not_started" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/student_detail_identity_status"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/student_detail_manage_enrollment"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/manage_enrollment" />
                </LinearLayout>

                <!-- 2. SS1 -> SS2 LEARNING PATH -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/student_learning_path_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/off_white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/slate_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/learning_path_title"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="@color/indigo_primary_dark"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/student_learning_path_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/slate_dark" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. CURRENT LEARNING -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/current_learning"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/indigo_primary_dark"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/student_current_learning_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/no_active_learning"
                    android:textColor="@color/slate_gray"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/student_current_learning_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <!-- 4. LEARNING HISTORY -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/learning_history"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/indigo_primary_dark"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/student_learning_history_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/no_learning_history"
                    android:textColor="@color/slate_gray"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/student_learning_history_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <!-- NO ENROLLMENTS CALL-TO-ACTION -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/student_no_enrollments_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/slate_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_enrollments_student"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/slate_gray" />

                        <TextView
                            android:id="@+id/tv_no_enrollments_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/archived_enrollment_disabled"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/slate_gray"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_enroll_in_class"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/enroll_in_class" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. SELECTED LEARNING RECORD CONTEXT -->
                <LinearLayout
                    android:id="@+id/student_selected_context_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/selected_learning_record"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/indigo_primary_dark"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/student_selected_context_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/slate_dark" />
                </LinearLayout>

                <!-- DETAILED ASSESSMENT PROFILE CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/student_assessment_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/slate_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/assessment_profile"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/indigo_primary_dark"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/assessment_unsupported_track"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/rubric_not_configured"
                            android:textColor="@color/slate_gray"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/assessment_empty_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/slate_gray"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/assessment_details_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/overall_score_label"
                                        android:textAppearance="?attr/textAppearanceLabelMedium"
                                        android:textColor="@color/slate_gray" />

                                    <TextView
                                        android:id="@+id/assessment_overall_score"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                        android:textColor="@color/indigo_primary_dark"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/assessment_overall_level_chip"
                                    style="@style/Widget.Material3.Chip.Assist"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="false"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/assessment_coverage_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/slate_gray" />

                            <th.ac.vu.classflow.ui.view.RadarChartView
                                android:id="@+id/assessment_radar_chart"
                                android:layout_width="match_parent"
                                android:layout_height="220dp"
                                android:layout_marginTop="12dp" />

                            <LinearLayout
                                android:id="@+id/assessment_domains_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="vertical" />

                            <TextView
                                android:id="@+id/assessment_strength_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@color/off_white"
                                android:padding="10dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="@color/indigo_primary_dark"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/assessment_next_step_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@color/off_white"
                                android:padding="10dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="@color/indigo_primary_dark"
                                android:visibility="gone" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/assessment_action_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/start_assessment"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- W01-W10 WEEKLY LEARNING JOURNEY & EDITOR -->
                <LinearLayout
                    android:id="@+id/student_progress_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/learning_journey"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/indigo_primary_dark"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/student_progress_journey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/progress_editor_week"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/indigo_primary_dark"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/progress_not_recorded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/not_recorded_draft"
                        android:textColor="@color/status_not_started" />

                    <TextView
                        android:id="@+id/progress_read_only"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/read_only_history"
                        android:textColor="@color/status_needs_attention"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/progress_metric_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="@string/overall_status">

                        <AutoCompleteTextView
                            android:id="@+id/progress_overall_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/overall_status"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/progress_blocker_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="@string/blocker">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/progress_blocker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/progress_teacher_note_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="@string/teacher_note"
                        app:counterEnabled="true"
                        app:counterMaxLength="500">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/progress_teacher_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textCapSentences|textMultiLine"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/progress_save"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/save_progress" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/student_detail_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <LinearLayout
            android:id="@+id/student_detail_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/student_detail_error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/status_blocked" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/student_detail_retry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/retry" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
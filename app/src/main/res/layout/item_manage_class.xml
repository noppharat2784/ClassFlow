<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/slate_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="6dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/manage_class_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/indigo_primary_dark"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/manage_class_track"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/slate_gray" />

            <TextView
                android:id="@+id/manage_class_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/indigo_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/manage_class_status"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:checkable="false"
                android:clickable="false"
                android:focusable="false"
                app:chipMinHeight="28dp"
                app:ensureMinTouchTargetSize="false" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/manage_class_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/class_actions"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
